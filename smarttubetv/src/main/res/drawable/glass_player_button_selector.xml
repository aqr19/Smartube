<?xml version="1.0" encoding="utf-8"?>
<!--
  SmartTube Player Control Glass Button Selector
  المسار: smarttubetv/src/main/res/drawable/glass_player_button_selector.xml
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- عند تحديد الزر بالريموت -->
    <item android:state_focused="true">
        <shape android:shape="oval">
            <gradient
                android:startColor="#59FFFFFF"
                android:endColor="#26FFFFFF"
                android:angle="270" />
            <stroke
                android:width="2dp"
                android:color="#E6FFFFFF" />
        </shape>
    </item>
    <!-- عند الضغط على الزر بـ OK -->
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#80FFFFFF" />
            <stroke
                android:width="2dp"
                android:color="#FFFFFF" />
        </shape>
    </item>
    <!-- الوضع الافتراضي للزر داخل شريط المشغل -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#1FFFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#26FFFFFF" />
        </shape>
    </item>
</selector>