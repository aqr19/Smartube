<?xml version="1.0" encoding="utf-8"?>
<!--
  SmartTube Player Control Glass Button Selector
  المسار: smarttubetv/src/main/res/drawable/glass_player_button_selector.xml
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- عند تحديد الزر بالريموت -->
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@color/tv_nav_focused" />
            <stroke
                android:width="2dp"
                android:color="@color/tv_accent" />
        </shape>
    </item>
    <!-- عند الضغط على الزر بـ OK -->
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/tv_accent_soft" />
            <stroke
                android:width="2dp"
                android:color="@color/tv_accent" />
        </shape>
    </item>
    <!-- الوضع الافتراضي للزر داخل شريط المشغل -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#1AFFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#33FFFFFF" />
        </shape>
    </item>
</selector>
