<?xml version="1.0" encoding="utf-8"?>
<!--
  SmartTube Player Control Glass Button Selector
  المسار: smarttubetv/src/main/res/drawable/glass_player_button_selector.xml
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- عند تحديد الزر بالريموت -->
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@color/cinema_focus_fill" />
            <stroke
                android:width="3dp"
                android:color="@color/cinema_focus" />
        </shape>
    </item>
    <!-- عند الضغط على الزر بـ OK -->
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#2D8BFF" />
            <stroke
                android:width="2dp"
                android:color="#FFFFFF" />
        </shape>
    </item>
    <!-- الوضع الافتراضي للزر داخل شريط المشغل -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#1FFFFFFF" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_border_subtle" />
        </shape>
    </item>
</selector>
