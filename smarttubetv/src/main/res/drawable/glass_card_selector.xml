<?xml version="1.0" encoding="utf-8"?>
<!--
  SmartTube Glass Card Selector
  المسار: smarttubetv/src/main/res/drawable/glass_card_selector.xml
  يعالج حالة التركيز (focused) والوضع العادي (default) على Android TV
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- حالة البطاقة عند توجيه ريموت التلفاز عليها (Focused State) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <!-- خلفية شبه شفافة مع تدرج لمعان علوي خفيف -->
            <gradient
                android:startColor="#40FFFFFF"
                android:endColor="#1AFFFFFF"
                android:angle="270" />
            <!-- حد ساطع ونظيف يعطي عمق الزجاج المصقول -->
            <stroke
                android:width="2dp"
                android:color="@color/glass_border_focused" />
        </shape>
    </item>

    <!-- حالة الضغط (Pressed State) -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#4DFFFFFF" />
            <stroke
                android:width="2.5dp"
                android:color="#FFFFFF" />
        </shape>
    </item>

    <!-- الحالة الافتراضية الهادئة (Default Idle State) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <!-- خلفية زجاجية معتمة بدرجة محسوبة لمنع التشتيت -->
            <solid android:color="@color/glass_surface_default" />
            <!-- حد رفيع جداً غير مزعج (1dp) -->
            <stroke
                android:width="1dp"
                android:color="@color/glass_border_subtle" />
        </shape>
    </item>
</selector>