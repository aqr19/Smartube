<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused State follows the TV theme's teal focus treatment. -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/tv_card_focused" />
            <stroke android:width="2dp" android:color="@color/tv_card_focus_border" />
        </shape>
    </item>

    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/tv_card_focused" />
            <stroke android:width="2dp" android:color="@color/tv_card_focus_border" />
        </shape>
    </item>

    <!-- Pressed State -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/tv_card_focused" />
            <stroke android:width="2dp" android:color="@color/tv_card_focus_border" />
        </shape>
    </item>

    <!-- Default idle card surface. -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/tv_card_default" />
            <stroke android:width="1dp" android:color="@color/tv_card_border" />
        </shape>
    </item>
</selector>
