<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Strong blue focus treatment, easy to follow with a TV remote -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/cinema_focus_fill" />
            <stroke
                android:width="3dp"
                android:color="@color/cinema_focus" />
        </shape>
    </item>

    <!-- Pressed State -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#245F9F" />
            <stroke
                android:width="2dp"
                android:color="#FFFFFF" />
        </shape>
    </item>

    <!-- Default Idle: سطح 161616 مع إطار 1px خفيف جداً بنسبة 8% -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#161616" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_border_subtle" />
        </shape>
    </item>
</selector>
