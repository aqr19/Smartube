<?xml version="1.0" encoding="utf-8"?>
<!-- MOD: Enable single click touch mode (focusableInTouchMode=false) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:tools="http://schemas.android.com/tools"
              android:focusableInTouchMode="true"
              android:focusable="true"
              android:orientation="vertical"
              android:layout_width="@dimen/settings_card_width"
              android:layout_height="@dimen/settings_card_height"
              android:padding="6dp"
              android:gravity="center_horizontal"
              android:background="@drawable/tv_settings_card_background"
              android:clipToOutline="true">
    <ImageView
        android:id="@+id/settings_image"
        android:layout_width="@dimen/settings_image_size"
        android:layout_height="@dimen/settings_image_size"
        android:layout_gravity="center"
        android:layout_margin="@dimen/settings_image_padding"
        android:visibility="invisible"
        tools:ignore="ContentDescription"/>
    <com.liskovsoft.smartyoutubetv2.tv.ui.widgets.marqueetextviewcompat.MarqueeTextViewCompat
        android:id="@+id/settings_title"
        android:singleLine="false"
        android:maxLines="2"
        android:minLines="2"
        android:ellipsize="end"
        android:layout_gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:textSize="14sp"
        android:textColor="@color/tv_settings_card_text"
        android:textAlignment="center"/>
</LinearLayout>
