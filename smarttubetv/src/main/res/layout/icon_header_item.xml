<?xml version="1.0" encoding="utf-8"?>
<androidx.leanback.widget.NonOverlappingLinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="12dp"
    android:paddingStart="12dp"
    android:paddingEnd="18dp"
    android:gravity="center_vertical"
    android:background="@drawable/glass_sidebar_item_selector"
    android:orientation="horizontal">

    <!-- حاوية الأيقونة الزجاجية المربعة المستديرة (Nuvio Squircle) -->
    <FrameLayout
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="center_vertical"
        android:background="@drawable/glass_sidebar_icon_bg">

        <ImageView
            android:id="@+id/header_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription="@string/header_icon" />
    </FrameLayout>

    <com.liskovsoft.smartyoutubetv2.tv.ui.widgets.marqueetextviewcompat.HeaderMarqueeTextViewCompat
        android:id="@+id/header_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_gravity="center_vertical"
        android:singleLine="true"
        android:textSize="18sp"
        android:maxWidth="180sp"
        android:textColor="@color/nuvio_nav_text_selector"
        android:marqueeRepeatLimit="marquee_forever"
        android:ellipsize="marquee"
        android:scrollHorizontally="true"
        style="@style/TextAppearance.Leanback.Header"/>

</androidx.leanback.widget.NonOverlappingLinearLayout>
